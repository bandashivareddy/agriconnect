DB_HOST=localhost
DB_PORT=5432
DB_NAME=agriconnect
DB_USER=postgres
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-strong-secret
LOG_LEVEL=INFO
# Defaults preserve localhost development when omitted. Add any required LAN or pilot origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Defaults allow localhost, 127.0.0.1, and the test client. Add your LAN or pilot hostnames as needed.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Set false to disable /docs, /redoc, and /openapi.json for a pilot deployment.
ENABLE_API_DOCS=true
DOCUMENT_STORAGE_DIR=storage/provider_documents
MAX_DOCUMENT_UPLOAD_MB=5
AGRI_TEST_DB_NAME=agriconnect_test
